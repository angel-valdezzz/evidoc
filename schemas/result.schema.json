{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidoc.local/schemas/result-1.0.0.schema.json",
  "title": "Evidoc Run Result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "test_id",
    "generated_at",
    "test_case",
    "steps",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "test_id": {
      "$ref": "#/$defs/identifier"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "test_case": {
      "$ref": "#/$defs/test_case"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "WARN", "INFO", "SKIP"]
    },
    "artifact_type": {
      "type": "string",
      "enum": ["image", "file", "log"]
    },
    "log_entry": {
      "type": "object",
      "required": ["level", "message", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/status"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "test_case": {
      "type": "object",
      "required": ["name", "status", "duration", "tags"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "application": {
          "type": ["string", "null"]
        },
        "requirement": {
          "type": ["string", "null"]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["title", "status", "logs", "artifact_ids"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "logs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/log_entry"
          }
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["id", "type"],
      "anyOf": [
        {"required": ["path"], "properties": {"path": {"type": "string"}}},
        {"required": ["data"], "properties": {"data": {"type": "string"}}}
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "$ref": "#/$defs/artifact_type"
        },
        "path": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "data": {"type": ["string", "null"], "minLength": 1},
        "capture": {"type": ["string", "null"], "enum": ["page", "element", "desktop", null]},
        "orientation": {"type": ["string", "null"], "enum": ["horizontal", "vertical", null]},
        "title": {
          "type": ["string", "null"]
        },
        "description": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
