@startuml
title Evidoc - Flujo principal

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #0F766E
skinparam activity {
  BackgroundColor #F0FDFA
  BorderColor #0F766E
  FontColor #062925
  DiamondBackgroundColor #FEF3C7
  DiamondBorderColor #D97706
}

start
:Framework o usuario invoca\nCLI / TUI / Python API / Robot;
:Evidoc abre o reutiliza run_id\ny crea contexto de prueba;
:Registrar pasos, logs\ny artefactos;
if (Se capturan evidencias?) then (si)
  :Guardar screenshots\ny adjuntos en artifacts/;
endif
:Construir resultado estructurado\n(schema_version, test_case,\nsteps, artifacts);
:Persistir JSON en disco\nen run-<id>/test-<id>/;
:Leer resultados desde source_dir;
if (mode = single?) then (si)
  :Generar un reporte por prueba;
else (no)
  :Consolidar corrida\ny generar un solo reporte;
endif
:Emitir salida final\nPDF o DOCX;
stop

@enduml
